{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usemingla.com/contracts/ari-certification-evidence.schema.json",
  "title": "Ari exact-release capability certification evidence",
  "type": "object",
  "required": ["schema_version", "run", "capabilities", "cleanup", "rollback"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run": {
      "type": "object",
      "required": ["ari_cert_run_id", "release_sha", "requirements_digest", "function_versions", "web_deployment", "release_artifacts", "native_artifacts", "tester_verdict", "server_attestation"],
      "additionalProperties": false,
      "properties": {
        "ari_cert_run_id": { "type": "string", "format": "uuid" },
        "release_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "requirements_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "function_versions": {
          "type": "object",
          "required": ["agent_chat", "agent_confirm_action"],
          "additionalProperties": false,
          "properties": {
            "agent_chat": { "type": "string", "minLength": 1 },
            "agent_confirm_action": { "type": "string", "minLength": 1 }
          }
        },
        "web_deployment": { "type": "string", "minLength": 1 },
        "release_artifacts": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["artifact_type", "artifact_id", "release_sha", "sha256"],
            "additionalProperties": false,
            "properties": {
              "artifact_type": { "enum": ["source", "agent_chat_bundle", "agent_confirm_bundle", "business_web", "business_ios_simulator", "business_ios_physical", "business_android"] },
              "artifact_id": { "type": "string", "minLength": 1 },
              "release_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "native_artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["surface", "artifact_id", "runtime_version", "device"],
            "additionalProperties": false,
            "properties": {
              "surface": { "enum": ["business_ios_simulator", "business_ios_physical", "business_android"] },
              "artifact_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$" },
              "runtime_version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$" },
              "device": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$" }
            }
          }
        },
        "tester_verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "server_attestation": {
          "type": "object",
          "required": ["algorithm", "canonicalization", "key_id", "evidence_set_digest", "artifact_set_digest", "capability_set_digest", "native_artifact_set_digest", "cleanup_digest", "rollback_digest", "run_manifest_digest", "signature"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "const": "HMAC-SHA256" },
            "canonicalization": { "const": "ARI-CERT-TUPLE-V1" },
            "key_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]{1,64}$" },
            "evidence_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "artifact_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "capability_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "native_artifact_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "cleanup_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "rollback_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "run_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 132,
      "maxItems": 132,
      "items": {
        "type": "object",
        "required": ["capability_id", "status", "surfaces", "scenarios", "canonical_readback", "tenant_role_matrix", "scenario_evidence", "evidence_digest"],
        "additionalProperties": false,
        "properties": {
          "capability_id": { "type": "string", "pattern": "^ari\\." },
          "status": { "enum": ["verified", "guided_handoff", "unsupported"] },
          "surfaces": {
            "type": "array",
            "items": { "enum": ["business_ios", "business_android", "business_web"] },
            "uniqueItems": true
          },
          "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "canonical_readback": { "type": ["string", "null"] },
          "tenant_role_matrix": { "type": "string", "minLength": 1 },
          "scenario_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["run_id", "capability_id", "scenario", "surface", "tenant_case", "role_case", "operation_id", "request_id", "client_turn_id", "execution_id", "artifact_type", "artifact_id", "canonical_readback_reference", "outcome", "safe_evidence", "evidence_digest"],
              "additionalProperties": false,
              "properties": {
                "run_id": { "type": "string", "format": "uuid" },
                "capability_id": { "type": "string", "pattern": "^ari\\." },
                "scenario": { "type": "string", "minLength": 1 },
                "surface": { "enum": ["business_ios", "business_android", "business_web"] },
                "tenant_case": { "enum": ["owner_tenant", "outsider_tenant"] },
                "role_case": { "enum": ["owner", "applicable_member", "below_threshold", "revoked", "outsider"] },
                "operation_id": { "type": "string", "format": "uuid" },
                "request_id": { "type": "string", "format": "uuid" },
                "client_turn_id": { "type": "string", "format": "uuid" },
                "execution_id": { "type": ["string", "null"], "format": "uuid" },
                "artifact_type": { "enum": ["source", "agent_chat_bundle", "agent_confirm_bundle", "business_web", "business_ios_simulator", "business_ios_physical", "business_android"] },
                "artifact_id": { "type": "string", "minLength": 1 },
                "canonical_readback_reference": { "type": ["string", "null"] },
                "outcome": { "const": "passed" },
                "safe_evidence": {
                  "type": "object",
                  "required": ["receipt_id", "readback_digest", "telemetry_event_id"],
                  "additionalProperties": false,
                  "properties": {
                    "receipt_id": { "type": "string", "format": "uuid" },
                    "readback_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "telemetry_event_id": { "type": "string", "format": "uuid" }
                  }
                },
                "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": ["verified_zero_residue", "manifest_digest"],
      "additionalProperties": false,
      "properties": {
        "verified_zero_residue": { "const": true },
        "manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["rehearsed", "prior_pair", "stranded_operation_count"],
      "additionalProperties": false,
      "properties": {
        "rehearsed": { "const": true },
        "prior_pair": { "type": "string", "minLength": 1 },
        "stranded_operation_count": { "const": 0 }
      }
    }
  }
}
