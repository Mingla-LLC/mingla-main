# Copy to .env.load (gitignored) — staging load-test fixtures (#426)
# See docs/load-test-fixtures.md

LOAD_BASE_URL=https://YOUR_REF.supabase.co/functions/v1
SUPABASE_ANON_KEY=

# Optional — ticket-checkout-create deeper path
LOAD_TEST_EVENT_ID=
LOAD_TEST_TICKET_TYPE_ID=

# Optional — agent-chat full path (node scripts/load/fetch-test-jwt.mjs)
LOAD_TEST_EMAIL=
LOAD_TEST_PASSWORD=
LOAD_TEST_USER_JWT=
LOAD_TEST_BRAND_ID=

# Public offering path (#426 G1 1A) — Host web origin + staging slugs
LOAD_HOST_WEB_ORIGIN=https://host.usemingla.com
# LOAD_PUBLIC_READ_MODE=cdn   # or rpc for native-shaped PostgREST traffic
LOAD_TEST_BRAND_SLUG=
LOAD_TEST_EVENT_SLUG=
LOAD_TEST_TRIP_SLUG=
LOAD_TEST_EXPERIENCE_SLUG=

# k6 tuning
LOAD_VUS=2
LOAD_DURATION=15s
