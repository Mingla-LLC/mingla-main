{
  "expo": {
    "name": "Mingla Host",
    "slug": "mingla-business",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sethogieva.minglabusiness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Mingla Host uses your camera to scan attendee tickets at the door.",
        "NSPhotoLibraryUsageDescription": "Mingla Host uses your photo library to upload brand and event imagery.",
        "NSPhotoLibraryAddUsageDescription": "Mingla Host saves event tickets to your photo library when you tap Save.",
        "NSFaceIDUsageDescription": "Mingla Host uses Face ID to confirm Apple Pay transactions at the door.",
        "NSUserTrackingUsageDescription": "Mingla Host uses your advertising identifier to measure the performance of our ads and help us reach more organizers like you.",
        "NSLocationWhenInUseUsageDescription": "Mingla Host uses your location to help measure the performance of our marketing and improve our services.",
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer-skadnetwork.com/",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork" },
          { "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork" },
          { "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork" }
        ]
      },
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.sethogieva.minglabusiness"
        ],
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.sethogieva.minglabusiness.onesignal"
        ]
      },
      "associatedDomains": [
        "applinks:host.usemingla.com",
        "applinks:biz.usemingla.com"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#eb7825",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sethogieva.minglabusiness",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/accept-brand-invitation"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/accept-brand-invitation/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/accept-scanner-invitation"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/accept-scanner-invitation/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/connect-onboarding"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/connect-onboarding/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/connect-account-management"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/connect-account-management/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/connect-partner-onboarding"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/connect-partner-onboarding/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/connect-partner-account-management"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/connect-partner-account-management/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/connect-tax-registrations"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/connect-tax-registrations/"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "path": "/stripe-onboarding-return"
            },
            {
              "scheme": "https",
              "host": "host.usemingla.com",
              "pathPrefix": "/stripe-onboarding-return/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "biz.usemingla.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.sethogieva.minglabusiness"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "android": false,
            "ios": false,
            "default": false
          }
        }
      ],
      "./plugins/withForcedLightAppearance",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#eb7825",
          "dark": {
            "backgroundColor": "#eb7825"
          }
        }
      ],
      [
        "react-native-appsflyer",
        {
          "shouldUseStrictMode": false,
          "shouldUsePurchaseConnector": false
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.sethogieva.minglabusiness",
          "enableGooglePay": true
        }
      ],
      "./plugins/withAdiRegistration",
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d30bbc0-38d9-4a41-bf69-de89cbf6d142",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.sethogieva.minglabusiness.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.sethogieva.minglabusiness.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2d30bbc0-38d9-4a41-bf69-de89cbf6d142"
    }
  }
}
