{
  "cli": {
    "version": ">= 16.25.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "buildConfiguration": "Debug"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "4505e476-6b2a-424d-906f-d751614980bf"
      }
    },
    "development-sim": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "4505e476-6b2a-424d-906f-d751614980bf"
      }
    },
    "preview-sim": {
      "distribution": "internal",
      "channel": "production",
      "ios": {
        "simulator": true
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "4505e476-6b2a-424d-906f-d751614980bf"
      }
    },
    "production-apk": {
      "autoIncrement": false,
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "4505e476-6b2a-424d-906f-d751614980bf"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "/Users/sethogieva/.mingla-secrets/playstore-mingla.json",
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6768737367"
      }
    }
