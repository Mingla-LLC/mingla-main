{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@mingla/brand-rendering": ["../packages/brand-rendering"],
      "@mingla/brand-rendering/*": ["../packages/brand-rendering/*"],
      "expo-video": ["./node_modules/expo-video"],
      "@mingla/offering-rendering": ["../packages/offering-rendering"],
      "@mingla/offering-rendering/*": ["../packages/offering-rendering/*"],
      "@mingla/theme-animations": ["../packages/theme-animations"],
      "@mingla/theme-animations/*": ["../packages/theme-animations/*"],
      "@mingla/payments-native": ["../packages/payments-native"],
      "@mingla/payments-native/*": ["../packages/payments-native/*"],
      "@mingla/phone-input": ["../packages/phone-input"],
      "@mingla/phone-input/*": ["../packages/phone-input/*"],
      "@mingla/location-input": ["../packages/location-input"],
      "@mingla/location-input/*": ["../packages/location-input/*"],
      "@mingla/brand-assets": ["../packages/brand-assets"],
      "@mingla/brand-assets/*": ["../packages/brand-assets/*"],
      "@mingla/help-content": ["../packages/help-content"],
      "@mingla/help-content/*": ["../packages/help-content/*"],
      "@mingla/card-identity": ["../packages/card-identity"],
      "@mingla/card-identity/*": ["../packages/card-identity/*"],
      "@mingla/sharing": ["../packages/sharing"],
      "@mingla/sharing/*": ["../packages/sharing/*"],
      "@mingla/search-measurement": ["../packages/search-measurement/src"],
      "expo-blur": ["./node_modules/expo-blur"],
      "expo-blur/*": ["./node_modules/expo-blur/*"],
      "lucide-react-native": ["./node_modules/lucide-react-native"],
      "lucide-react-native/*": ["./node_modules/lucide-react-native/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-native": ["./node_modules/react-native"],
      "react-native-svg": ["./node_modules/react-native-svg"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "server/__tests__/issue_3281_social_preview_schedule.implementor.test.ts",
    "server/__tests__/issue_3281_public_event_start_meta.implementor.test.ts",
    "src/components/scanner/__tests__/issue_3281_scan_result_date_copy.implementor.test.ts",
    "src/utils/__tests__/issue_3281_guest_csv_day_order.implementor.test.ts",
    "src/components/checkout/__tests__/issue_3281_by_date_quantities.implementor.test.ts"
  ]
}
