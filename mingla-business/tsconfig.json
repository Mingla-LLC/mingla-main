{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@mingla/event-rendering": ["../packages/event-rendering"],
      "@mingla/event-rendering/*": ["../packages/event-rendering/*"],
      "@mingla/payments-native": ["../packages/payments-native"],
      "@mingla/payments-native/*": ["../packages/payments-native/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
