{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@mingla/brand-rendering": ["../packages/brand-rendering"],
      "@mingla/brand-rendering/*": ["../packages/brand-rendering/*"],
      "expo-video": ["./node_modules/expo-video"],
      "@mingla/offering-rendering": ["../packages/offering-rendering"],
      "@mingla/offering-rendering/*": ["../packages/offering-rendering/*"],
      "@mingla/theme-animations": ["../packages/theme-animations"],
      "@mingla/theme-animations/*": ["../packages/theme-animations/*"],
      "@mingla/payments-native": ["../packages/payments-native"],
      "@mingla/payments-native/*": ["../packages/payments-native/*"],
      "@mingla/phone-input": ["../packages/phone-input"],
      "@mingla/phone-input/*": ["../packages/phone-input/*"],
      "@mingla/location-input": ["../packages/location-input"],
      "@mingla/location-input/*": ["../packages/location-input/*"],
      "@mingla/brand-assets": ["../packages/brand-assets"],
      "@mingla/brand-assets/*": ["../packages/brand-assets/*"],
      "@mingla/card-identity": ["../packages/card-identity"],
      "@mingla/card-identity/*": ["../packages/card-identity/*"],
      "expo-blur": ["./node_modules/expo-blur"],
      "expo-blur/*": ["./node_modules/expo-blur/*"],
      "lucide-react-native": ["./node_modules/lucide-react-native"],
      "lucide-react-native/*": ["./node_modules/lucide-react-native/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native-svg": ["./node_modules/react-native-svg"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
