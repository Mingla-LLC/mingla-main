diff --git a/node_modules/@gorhom/bottom-sheet/src/utilities/keyboardDetentIndex.ts b/node_modules/@gorhom/bottom-sheet/src/utilities/keyboardDetentIndex.ts
new file mode 100644
index 0000000..10f0238
--- /dev/null
+++ b/node_modules/@gorhom/bottom-sheet/src/utilities/keyboardDetentIndex.ts
@@ -0,0 +1,19 @@
+/**
+ * Mingla patch (#4473): the index a keyboard-lifted sheet reports and later
+ * restores to. Upstream assigned the highest detent's POSITION (e.g. 103.5)
+ * as the index, so `keyboardBlurBehavior="restore"` looked up
+ * `detents[103.5]` (undefined) and the sheet stayed lifted after the keyboard
+ * closed. Return the highest detent's index instead.
+ */
+export const getKeyboardDetentIndex = (
+  detents: number[] | undefined,
+  highestDetentPosition: number | undefined,
+  fallback: number
+): number => {
+  'worklet';
+  if (!detents || highestDetentPosition === undefined) {
+    return fallback;
+  }
+  const index = detents.indexOf(highestDetentPosition);
+  return index === -1 ? fallback : index;
+};
