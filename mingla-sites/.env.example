# mingla-sites (public Sites runtime) — environment variable NAMES.
# Placeholder values only. Real values live in the Vercel project (production)
# or in the gitignored .env.local written by
# scripts/sites/local/generate-local-keys.mjs (local; docs/runbooks/SITES_LOCAL_STACK.md).

# --- Required in every environment -----------------------------------------
SITES_CORE_BASE_URL=https://<core-project-ref>.supabase.co
SITES_CORE_ANON_KEY=<core-anon-key>
SITES_CMS_PROJECT_REF=<20-char-sites-cms-project-ref>
SITES_STORAGE_SUPABASE_URL=https://<sites-cms-project-ref>.supabase.co
SITES_STORAGE_SUPABASE_ANON_KEY=<sites-cms-anon-key>
SITES_STORAGE_READER_EMAIL=<runtime-reader-email>
SITES_STORAGE_READER_PASSWORD=<runtime-reader-password>
SITES_PUBLICATION_ARTIFACT_BUCKET=sites-publication-artifacts
SITES_MEDIA_APPROVED_BUCKET=sites-media-approved
MINGLA_RUNTIME_TO_CORE_CURRENT_KID=<key-id>
MINGLA_RUNTIME_TO_CORE_CURRENT_KEY_B64=<base64-32-bytes>
SITES_PILOT_SITE_ID=<site-uuid>
SITES_CANDIDATE_PROBE_SECRET=<base64-32-bytes>
# Optional; production requires sites.usemingla.com, local requires sites.localhost.
SITES_ALLOWED_HOST_SUFFIX=sites.usemingla.com

# --- LOCAL ONLY (never set these on Vercel: the build fails if you do) -----
# Local mode turns on only when ALL agree: SITES_LOCAL_MODE=1, no VERCEL /
# VERCEL_ENV, and loopback http://127.0.0.1:<port> backends.
# SITES_LOCAL_MODE=1
# SITES_LOCAL_EXTRA_HOSTS=brand-domain.test
# SITES_RUNTIME_MEDIA_KEY_B64=<base64-32-bytes>
