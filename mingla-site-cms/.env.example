# mingla-site-cms (Mingla Studio) — environment variable NAMES.
# Placeholder values only. Real values live in the Vercel project (production)
# or in the gitignored .env.local written by
# scripts/sites/local/generate-local-keys.mjs (local; docs/runbooks/SITES_LOCAL_STACK.md).

# --- Required in every environment -----------------------------------------
DATABASE_URL=postgresql://sites_cms_app.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
SITES_DATABASE_CONNECTION_MODE=runtime
SITES_DATABASE_POOL_MAX=3
PAYLOAD_SECRET=<base64-32-bytes>
SITES_CORE_BASE_URL=https://<core-project-ref>.supabase.co
SITES_CMS_ORIGIN=https://studio.sites.usemingla.com
SITES_PUBLIC_RUNTIME_ORIGIN=https://<site-host>
SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-2
SUPABASE_S3_ACCESS_KEY_ID=<s3-access-key-id>
SUPABASE_S3_SECRET_ACCESS_KEY=<s3-secret>
SITES_MEDIA_QUARANTINE_BUCKET=sites-media-quarantine
SITES_MEDIA_APPROVED_BUCKET=sites-media-approved
SITES_PUBLICATION_ARTIFACT_BUCKET=sites-publication-artifacts
SITES_MEDIA_RECOVERY_BUCKET=sites-media-recovery
SITES_PREVIEW_SIGNING_SECRET=<base64-32-bytes>
MINGLA_CMS_TO_CORE_CURRENT_KID=<key-id>
MINGLA_CMS_TO_CORE_CURRENT_KEY_B64=<base64-32-bytes>
MINGLA_CORE_TO_CMS_CURRENT_KID=<key-id>
MINGLA_CORE_TO_CMS_CURRENT_KEY_B64=<base64-32-bytes>
# Optional rotation pair (set both or neither).
MINGLA_CORE_TO_CMS_PREVIOUS_KID=
MINGLA_CORE_TO_CMS_PREVIOUS_KEY_B64=
SITES_CANDIDATE_PROBE_SECRET=<base64-32-bytes>

# --- LOCAL ONLY (never set these on Vercel: the build fails if you do) -----
# Local mode turns on only when ALL agree: SITES_LOCAL_MODE=1, no VERCEL /
# VERCEL_ENV, loopback origins, a loopback database (TLS off) and the local
# Sites CMS stack's S3 endpoint with SUPABASE_S3_REGION=local.
# SITES_LOCAL_MODE=1
