# Mingla Marketing — environment variables.
#
# ORCH-1045 [Business "Get Beta Access" lead-capture]: the organiser beta-access
# form POSTs to the public `beta-access-lead-submit` edge function. Both vars are
# PUBLIC by design — the anon key only allows calling RLS-protected endpoints;
# beta_access_leads denies anon SELECT and the edge fn writes via the service
# role server-side. Never put a service-role key in this app.

# Supabase Edge Functions base URL (no trailing slash). One of:
#   https://<project-ref>.functions.supabase.co
#   https://<project-ref>.supabase.co/functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://gqnoajqerqhnvulmnyvv.functions.supabase.co

# Supabase anon (publishable) key — public; safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── META-ORCH-1187 [Growth Analytics Hub] Phase 1 — analytics (web-only) ──────
# All three are PUBLIC by design and safe in the browser bundle.
#
# PostHog client key — the `phc_*` PROJECT key (project 479999, US region).
# NEVER put the `phx_*` personal/MCP key here or anywhere in client source.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# PostHog ingestion host — US region, dispatch-locked. Do not change to eu/app host.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# GA4 Measurement ID — public; single shared stream (usemingla.com).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-Z4W3B9900S
