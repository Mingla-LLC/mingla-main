{
  "rewrites": [
    { "source": "/p/:shareId", "has": [{ "type": "host", "value": "route-manifest.invalid" }], "destination": "/api/internal-share-proxy/page/:shareId" },
    { "source": "/share/:shareId.png", "has": [{ "type": "host", "value": "route-manifest.invalid" }], "destination": "/api/internal-share-proxy/snippet/:shareId" },
    { "source": "/og/share/:shareId.png", "has": [{ "type": "host", "value": "route-manifest.invalid" }], "destination": "/api/internal-share-proxy/og/:shareId" },
    { "source": "/api/shared-card/:shareId", "has": [{ "type": "host", "value": "route-manifest.invalid" }], "destination": "/api/internal-share-proxy/data/:shareId" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
