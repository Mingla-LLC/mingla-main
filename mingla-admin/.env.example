# mingla-admin — environment variables (example / documentation).
# Copy relevant values into a local `.env.local` (git-ignored) for development.

# Public production authority. Preview/development may override this explicitly,
# but production must resolve to the checked-in authority contract.
VITE_SUPABASE_URL=https://gqnoajqerqhnvulmnyvv.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Sentry crash reporting (#1322).
# DSN for the SHARED `mingla-business` Sentry project (org `mingla-llc`) — admin
# reuses that project (OQ-1, Option B) and is distinguished from business errors
# by an `admin-*` `environment` tag (`admin-production` in prod, `admin-<mode>`
# otherwise), set in src/diagnostics/sentry.js via src/main.jsx.
#
# `VITE_*` is inlined into the JS bundle at BUILD time, so a fresh production
# build (NOT a redeploy of an old build) is required to pick up a newly-set DSN.
# Absent  => crash reporting is a safe no-op.
# A Vercel PRODUCTION build HARD-FAILS if this is absent
# (scripts/ci/require-sentry-dsn-on-prod.mjs, wired first in vercel.json).
VITE_SENTRY_DSN=
